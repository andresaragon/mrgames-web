  "narrative": {
    "northStar": "La Sala de Arcade",
    "overview": "Un salón oscuro donde cada carátula brilla como una pantalla encendida y el rojo neón señala dónde actuar. El fondo medianoche desaparece para que el catálogo hable; el carmesí aparece solo donde hay decisión.",
    "keyCharacteristics": ["Oscuro en capas: superficies navy planas, brillo carmesí como respuesta a la interacción.","Carátulas como protagonista; el chrome de la interfaz se queda atrás.","Display condensado en mayúsculas para títulos, precios y etiquetas de acción.","Verde esmeralda reservado para disponibilidad/consulta y WhatsApp."],
    "rules": [
      {"name":"The One Signal Rule","body":"El carmesí marca acción o precio. Si todo es rojo, nada lo es.","section":"colors"},
      {"name":"The Green Is WhatsApp Rule","body":"El esmeralda se reserva para WhatsApp y disponibilidad; nunca decora.","section":"colors"},
      {"name":"The Price Is Display Rule","body":"Los precios van en Rajdhani carmesí suave; es lo primero que se escanea después de la carátula.","section":"typography"},
      {"name":"The Glow Is A Response Rule","body":"En reposo las superficies son planas; el brillo aparece al interactuar o en la acción principal.","section":"elevation"}
    ],
    "dos": ["Do usar #ff2b56 solo para acción, precio y énfasis puntual.","Do dejar que las carátulas 2:3 ocupen el protagonismo en rejillas de 2 columnas en móvil.","Do poner títulos y precios en Rajdhani, y la lectura en Geist.","Do reservar el glow para el botón primario y estados hover.","Do mantener el esmeralda para WhatsApp y disponibilidad."],
    "donts": ["Don't usar fondos claros ni blancos: el sistema es oscuro.","Don't aplicar glow en reposo sobre superficies decorativas.","Don't usar más de un acento fuerte por pantalla.","Don't inventar urgencia, stock ni testimonios (ver PRODUCT.md).","Don't cortar ni deformar las carátulas."]
